APP_NAME="WARISS.DEV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Français par défaut, anglais en second (décision « Langues »)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux quotidiens, conservés 14 jours
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (base de test : wariss_dev_test, voir phpunit.xml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wariss_dev
DB_USERNAME=wariss_dev
DB_PASSWORD=

# En local, sessions, cache et files utilisent PostgreSQL (D-11) ; Redis en production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Applications frontend autorisées à utiliser le cookie de session Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
# Origines autorisées à appeler l'API avec cookies (CORS) : site public et administration
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Redis (production) : client pur PHP, sans extension
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, les e-mails sont écrits dans storage/logs.
# Avec Mailpit (fourni par Laragon) : MAIL_MAILER=smtp, MAIL_PORT=1025, interface http://localhost:8025
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@wariss.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage objet compatible S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Comptes créés par « php artisan db:seed » (D-04). À renseigner dans .env uniquement :
# aucune donnée personnelle dans ce fichier versionné. Sans e-mail, le compte n'est pas créé.
# Mot de passe vide : généré et affiché une seule fois en local, obligatoire en production.
# Changer un mot de passe ensuite (saisie masquée) : php artisan app:set-password {email}
SEED_ADMIN_NAME="Administrateur"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_VIEWER_NAME="Lecteur"
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=

# Outils de développement (local uniquement)
TELESCOPE_ENABLED=true
